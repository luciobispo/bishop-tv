<?xml version="1.0" encoding="utf-8"?>
<!--
    Controle do player: título no topo e, embaixo, tempo + barra de progresso
    e a fileira de botões. Os ids exo_* são os que o PlayerControlView do
    Media3 procura e liga ao player sozinho; os bishop_* o PlayerActivity cuida.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/bishop_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/player_scrim_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="24dp"
        android:paddingTop="16dp"
        android:paddingRight="24dp"
        android:paddingBottom="40dp">

        <ImageButton
            android:id="@+id/bishop_back"
            style="@style/PlayerButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="0dp"
            android:contentDescription="Voltar"
            android:src="@drawable/ic_player_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/bishop_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bishop_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#FFB8B8C2"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Mesmo tamanho do botão Voltar, para o título ficar centralizado. -->
        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/player_scrim_bottom"
        android:orientation="vertical"
        android:paddingLeft="32dp"
        android:paddingTop="56dp"
        android:paddingRight="32dp"
        android:paddingBottom="18dp">

        <!-- Ao vivo: selo, programa no ar (EPG) com horários e barra, e o próximo. -->
        <LinearLayout
            android:id="@+id/bishop_live"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="30dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/player_live_badge"
                    android:paddingLeft="10dp"
                    android:paddingTop="4dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="4dp"
                    android:text="●  AO VIVO"
                    android:textColor="#FFE50914"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Margens laterais: o título centraliza sem passar por cima do selo. -->
                <TextView
                    android:id="@+id/bishop_epg_now"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="120dp"
                    android:layout_marginRight="120dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/bishop_epg_bar"
                android:layout_width="480dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/bishop_epg_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFDDDDDD"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/bishop_epg_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_marginLeft="12dp"
                    android:layout_marginRight="12dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:maxHeight="5dp"
                    android:minHeight="5dp"
                    android:progressDrawable="@drawable/player_epg_progress" />

                <TextView
                    android:id="@+id/bishop_epg_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFDDDDDD"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/bishop_epg_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#FFB8B8C2"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bishop_timeline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_marginLeft="14dp"
                android:layout_marginRight="14dp"
                android:layout_weight="1"
                app:buffered_color="#66FFFFFF"
                app:played_color="#FFE50914"
                app:scrubber_color="#FFE50914"
                app:unplayed_color="#33FFFFFF" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@id/exo_rew"
                style="@style/PlayerButton"
                android:contentDescription="Voltar 10 segundos"
                android:src="@drawable/exo_icon_rewind" />

            <ImageButton
                android:id="@id/exo_play_pause"
                style="@style/PlayerButton"
                android:contentDescription="Reproduzir ou pausar" />

            <ImageButton
                android:id="@id/exo_ffwd"
                style="@style/PlayerButton"
                android:contentDescription="Avançar 10 segundos"
                android:src="@drawable/exo_icon_fastforward" />

            <ImageButton
                android:id="@+id/bishop_fav"
                style="@style/PlayerButton"
                android:contentDescription="Minha Lista"
                android:src="@drawable/ic_player_fav_off"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/bishop_aspect"
                style="@style/PlayerButton"
                android:contentDescription="Proporção da tela"
                android:src="@drawable/ic_player_aspect" />

            <ImageButton
                android:id="@id/exo_settings"
                style="@style/PlayerButton"
                android:contentDescription="Configurações"
                android:src="@drawable/exo_ic_settings" />
        </LinearLayout>
    </LinearLayout>
</merge>
